# ==============================================================================
# DEVA YADHALA PORTFOLIO - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and configure your local/production environment values.
# NEVER commit the actual .env file with real secrets to version control!
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/portfolio_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT Security Settings (Must be 32+ characters / 256-bit key)
JWT_SECRET=super_secret_jwt_key_for_dev_min_32_characters_long_portfolio_system_2026
JWT_EXPIRATION_MS=86400000

# Initial Admin Setup (Leave password empty to disable automatic initialization,
# or provide an initial credentials pair for first-time development startup)
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_EMAIL=admin@devayadhala.local
ADMIN_INITIAL_PASSWORD=admin123

# Server Port
PORT=8080

# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:5173

# ==============================================================================
# SUPABASE STORAGE CONFIGURATION (Persistent Cloud Storage for Render / Production)
# ==============================================================================
# 1. SUPABASE_URL: Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
# 2. SUPABASE_SERVICE_ROLE_KEY (or SUPABASE_KEY): Supabase Service Role Key (from Project Settings -> API)
# 3. SUPABASE_BUCKET_CERTIFICATIONS: Bucket name for certificates (default: portfolio-certifications)
# 4. SUPABASE_BUCKET_RESUMES: Bucket name for resumes (default: portfolio-resumes)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_BUCKET_CERTIFICATIONS=portfolio-certifications
SUPABASE_BUCKET_RESUMES=portfolio-resumes

